# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── 模型权重与训练产物 ──
# 文件极大，绝对不能提交（GitHub 单文件上限 100MB）
*.pt
*.onnx
*.gguf
runs/

# ── 图片 ──
*.jpg
*.png

# ── 编辑器 ──
.vscode/
.idea/

# ── 工具的输出结果（照片副本 + 报告），随时可重新生成 ──
output/

# ── 数据集压缩包（体积大，不上传）──
*.zip

# ── 本地数据（图片、数据集、生成结构）──
# 体积大且含个人文件信息
data/

# ── Web 界面运行时上传的临时文件 ──
web/uploads/

# ── 前端库：保持仓库体积小，不进仓库，用 README 里的命令自行下载 ──
web/static/vue.global.prod.js

# ── ⚠️ 密钥文件：绝对不能进仓库 ──
# 这一条是"事故级"的：key 一旦提交到 GitHub，就算马上删掉，
# 它也已经进了 git 历史，机器人会在几分钟内扫到并盗用。
# 所以宁可多排除几个名字。
.env
.env.*
*.key
secrets.json
data/.credentials*

# ── 例外：README 里要展示的插图，需要提交到仓库 ──
!docs/*.png
!docs/*.jpg